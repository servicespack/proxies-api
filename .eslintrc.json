{
    "env": {
        "es2021": true,
        "node": true,
        "jest/globals": true
    },
    "extends": "@gabrielrufino/eslint-config",
    "plugins": [
        "jest"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "ignorePatterns": [
        "dist"
    ],
    "overrides": [
        {
            "files": ["tsdown.config.ts"],
            "rules": {
                "import/no-extraneous-dependencies": "off"
            }
        }
    ],
    "rules": {
    }
}
