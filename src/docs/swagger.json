{
  "openapi": "3.0.3",
  "info": {
    "title": "Proxies Service",
    "description": "Dynamic reverse proxy management API"
  },
  "servers": [],
  "components": {
    "securitySchemes": {
      "Token": {
        "type": "apiKey",
        "in": "query",
        "name": "token"
      }
    },
    "parameters": {
      "proxyId": {
        "in": "path",
        "name": "proxyId",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "schemas": {
      "ProxyParams": {
        "type": "object",
        "required": [
          "namespace",
          "target"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "example": "users"
          },
          "target": {
            "type": "string",
            "format": "uri",
            "example": "https://users.yourmicroservices.dev"
          }
        }
      },
      "UpdateProxyParams": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "example": "users"
          },
          "target": {
            "type": "string",
            "format": "uri",
            "example": "https://users.yourmicroservices.dev"
          }
        }
      },
      "Proxy": {
        "allOf": [
          { "$ref": "#/components/schemas/ProxyParams" },
          {
            "type": "object",
            "required": [
              "id",
              "createdAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "example": "664bbec08e4dcfefbe811345"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "example": "2026-09-24T12:00:00.000Z"
              }
            }
          }
        ]
      }
    },
    "errors": {
      "BadRequest": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Conflict": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Proxy with namespace 'users' already exists"
          }
        }
      },
      "NotFound": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Not found"
          }
        }
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Unauthorized"
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": ["Health"],
        "summary": "Healthcheck / ping endpoint",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "I": {
                      "type": "string",
                      "example": "am alive"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/proxies": {
      "get": {
        "tags": ["Proxies"],
        "security": [{ "Token": [] }],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Proxy"
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/Unauthorized"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Proxies"],
        "security": [{ "Token": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProxyParams"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proxy"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/BadRequest"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/Unauthorized"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/Conflict"
                }
              }
            }
          }
        }
      }
    },
    "/proxies/{proxyId}": {
      "get": {
        "tags": ["Proxies"],
        "security": [{ "Token": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/proxyId" }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proxy"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/Unauthorized"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/NotFound"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Proxies"],
        "security": [{ "Token": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/proxyId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProxyParams"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proxy"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/BadRequest"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/Unauthorized"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/NotFound"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/Conflict"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Proxies"],
        "security": [{ "Token": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/proxyId" }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Proxy"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/Unauthorized"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/errors/NotFound"
                }
              }
            }
          }
        }
      }
    }
  }
}
